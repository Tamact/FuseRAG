#
# Copie ce fichier en ".env" et remplis les valeurs.
# Ne commit jamais ".env" (il contient des secrets).
#

# --- Sécurité API ---
# Si vide: aucune authentification (public).
# Si défini: envoyer le header HTTP "X-API-Key: <valeur>" sur chaque requête.
RAG_API_KEY=

# --- Stockage / Index ---
RAG_PERSIST_DIR=chroma_db
RAG_COLLECTION=rag_chunks

# --- Fichier de config (non secret) ---
# Copie "rag.config.json.example" en "rag.config.json" et change les valeurs.
RAG_CONFIG_PATH=rag.config.json

# --- Modèles ---
# Modèle LLM Ollama (génération)
RAG_LLM_MODEL=qwen2.5:3b

# Modèle embeddings (Hugging Face)
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Modèle reranker (SentenceTransformers)
RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Hugging Face ---
# Recommandé pour éviter les rate limits / accélérer les downloads.
HF_TOKEN=

# (Optionnel) désactiver certains warnings HF
# HF_HUB_DISABLE_IMPLICIT_TOKEN_WARNING=1
# HF_HUB_DISABLE_SYMLINKS_WARNING=1

